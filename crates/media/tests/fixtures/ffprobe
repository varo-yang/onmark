#!/bin/sh

metadata_entries='format=duration:stream=index,codec_type,codec_name,pix_fmt,width,height,color_range,color_space,color_transfer,color_primaries,duration,sample_rate,channels:stream_disposition=default,attached_pic'
frame_entries='frame=best_effort_timestamp,pkt_duration:stream=time_base,duration_ts'

mode=
if [ "$#" -eq 8 ] && \
   [ "$1" = "-v" ] && [ "$2" = "error" ] && \
   [ "$3" = "-show_entries" ] && [ "$4" = "$metadata_entries" ] && \
   [ "$5" = "-of" ] && [ "$6" = "json" ] && [ "$7" = "--" ]; then
  mode=metadata
elif [ "$#" -eq 11 ] && \
     [ "$1" = "-v" ] && [ "$2" = "error" ] && \
     [ "$3" = "-select_streams" ] && \
     [ "$5" = "-show_frames" ] && \
     [ "$6" = "-show_entries" ] && [ "$7" = "$frame_entries" ] && \
     [ "$8" = "-of" ] && [ "$9" = "json" ] && [ "${10}" = "--" ]; then
  mode=frames
else
  printf 'unexpected ffprobe arguments\n' >&2
  exit 2
fi

for argument do
  input=$argument
done

constant_frames() {
  timebase=$1
  count=$2
  index=0
  printf '{"frames":['
  while [ "$index" -lt "$count" ]; do
    if [ "$index" -ne 0 ]; then
      printf ','
    fi
    printf '{"best_effort_timestamp":"%s","pkt_duration":"1"}' "$index"
    index=$((index + 1))
  done
  printf '],"streams":[{"time_base":"%s","duration_ts":"%s"}]}' "$timebase" "$count"
}

if [ "$mode" = frames ]; then
  case "${input##*/}" in
    valid.mp4|partial-color.mp4|audiovisual.mp4|stream-selection.mp4|stream-duration-only.mp4)
      constant_frames 1/30 60
      ;;
    format-duration-only.mp4)
      constant_frames 1/30 75
      ;;
    variable.mp4)
      printf '{"frames":[{"best_effort_timestamp":0,"pkt_duration":40},{"best_effort_timestamp":40,"pkt_duration":60},{"best_effort_timestamp":100,"pkt_duration":40}],"streams":[{"time_base":"1/1000","duration_ts":140}]}'
      ;;
    still.mp4)
      printf '{"frames":[{"best_effort_timestamp":"0","pkt_duration":"2000"}],"streams":[{"time_base":"1/1000","duration_ts":"2000"}]}'
      ;;
    empty-video.mp4)
      printf '{"frames":[],"streams":[{"time_base":"1/30","duration_ts":"0"}]}'
      ;;
    invalid-video-duration.mp4)
      printf '{"frames":[{"best_effort_timestamp":"0","pkt_duration":"1"},{"best_effort_timestamp":"1","pkt_duration":"1"}],"streams":[{"time_base":"1/30","duration_ts":"invalid"}]}'
      ;;
    *)
      printf 'unexpected frame fixture input: %s\n' "$input" >&2
      exit 2
      ;;
  esac
  exit 0
fi

case "${input##*/}" in
  valid.mp4)
    printf '{"streams":[{"index":0,"codec_type":"video","codec_name":"h264","pix_fmt":"yuv420p","width":1920,"height":1080,"color_range":"tv","color_space":"bt709","color_transfer":"bt709","color_primaries":"bt709","duration":"2.000000"}],"format":{"duration":"2.500000"}}'
    ;;
  partial-color.mp4)
    printf '{"streams":[{"index":0,"codec_type":"video","codec_name":"h264","pix_fmt":"yuv420p","width":1920,"height":1080,"color_space":"bt709","duration":"2.000000"}],"format":{"duration":"2.500000"}}'
    ;;
  audio.mp3)
    printf '{"streams":[{"codec_type":"audio","sample_rate":"48000","channels":1}],"format":{"duration":"2.500000"}}'
    ;;
  audiovisual.mp4)
    printf '{"streams":[{"index":0,"codec_type":"video","codec_name":"h264","pix_fmt":"yuv420p","width":1920,"height":1080,"duration":"2.000000"},{"codec_type":"audio","duration":"1.500000","sample_rate":"44100","channels":2}],"format":{"duration":"2.500000"}}'
    ;;
  stream-selection.mp4)
    printf '{"streams":[{"index":0,"codec_type":"video","disposition":{"default":1,"attached_pic":1}},{"index":5,"codec_type":"video","codec_name":"h264","pix_fmt":"yuv420p","width":1920,"height":1080,"duration":"1.000000","disposition":{"default":1,"attached_pic":0}},{"index":2,"codec_type":"audio","duration":"1.000000","sample_rate":"32000","channels":1,"disposition":{"default":0,"attached_pic":0}},{"index":7,"codec_type":"audio","duration":"1.000000","sample_rate":"44100","channels":1,"disposition":{"default":1,"attached_pic":0}},{"index":3,"codec_type":"video","codec_name":"h264","pix_fmt":"yuv420p","width":1920,"height":1080,"duration":"2.000000","disposition":{"default":1,"attached_pic":0}},{"index":4,"codec_type":"audio","duration":"2.000000","sample_rate":"48000","channels":2,"disposition":{"default":1,"attached_pic":0}}],"format":{"duration":"2.500000"}}'
    ;;
  stream-duration-only.mp4)
    printf '{"streams":[{"index":0,"codec_type":"video","codec_name":"h264","pix_fmt":"yuv420p","width":1920,"height":1080,"duration":"2.000000"},{"codec_type":"audio","duration":"1.500000","sample_rate":"48000","channels":2}],"format":{}}'
    ;;
  format-duration-only.mp4)
    printf '{"streams":[{"index":0,"codec_type":"video","codec_name":"h264","pix_fmt":"yuv420p","width":1920,"height":1080}],"format":{"duration":"2.500000"}}'
    ;;
  metadata-only.bin)
    printf '{"streams":[{"codec_type":"subtitle"}],"format":{"duration":"2.500000"}}'
    ;;
  variable.mp4)
    printf '{"streams":[{"index":0,"codec_type":"video","codec_name":"h264","pix_fmt":"yuv420p","width":1920,"height":1080,"duration":"0.140000"}],"format":{"duration":"0.140000"}}'
    ;;
  still.mp4)
    printf '{"streams":[{"index":0,"codec_type":"video","codec_name":"h264","pix_fmt":"yuv420p","width":1920,"height":1080,"duration":"2.000000"}],"format":{"duration":"2.500000"}}'
    ;;
  empty-video.mp4)
    printf '{"streams":[{"index":0,"codec_type":"video","codec_name":"h264","pix_fmt":"yuv420p","width":1920,"height":1080,"duration":"2.000000"}],"format":{"duration":"2.500000"}}'
    ;;
  invalid-video-duration.mp4)
    printf '{"streams":[{"index":0,"codec_type":"video","codec_name":"h264","pix_fmt":"yuv420p","width":1920,"height":1080,"duration":"invalid"}],"format":{"duration":"2.500000"}}'
    ;;
  missing-video-width.mp4)
    printf '{"streams":[{"codec_type":"video","codec_name":"h264","pix_fmt":"yuv420p","height":1080,"duration":"2.000000"}],"format":{"duration":"2.500000"}}'
    ;;
  zero-video-height.mp4)
    printf '{"streams":[{"codec_type":"video","codec_name":"h264","pix_fmt":"yuv420p","width":1920,"height":0,"duration":"2.000000"}],"format":{"duration":"2.500000"}}'
    ;;
  missing-audio-sample-rate.mp3)
    printf '{"streams":[{"codec_type":"audio"}],"format":{"duration":"2.500000"}}'
    ;;
  missing-audio-channels.mp3)
    printf '{"streams":[{"codec_type":"audio","sample_rate":"48000"}],"format":{"duration":"2.500000"}}'
    ;;
  surround.mp3)
    printf '{"streams":[{"codec_type":"audio","sample_rate":"48000","channels":6}],"format":{"duration":"2.500000"}}'
    ;;
  excessive-channels.mp3)
    printf '{"streams":[{"codec_type":"audio","sample_rate":"48000","channels":256}],"format":{"duration":"2.500000"}}'
    ;;
  invalid-audio-duration.mp3)
    printf '{"streams":[{"codec_type":"audio","duration":"invalid","sample_rate":"48000","channels":2}],"format":{"duration":"2.500000"}}'
    ;;
  failed.mp4)
    printf 'probe failed' >&2
    exit 7
    ;;
  failed-tail.mp4)
    index=0
    while [ "$index" -lt 1024 ]; do
      printf '0123456789abcdef' >&2
      index=$((index + 1))
    done
    printf 'final probe failure' >&2
    exit 7
    ;;
  invalid-json.mp4)
    printf 'not json'
    ;;
  missing-duration.mp4)
    printf '{"format":{}}'
    ;;
  invalid-duration.mp4)
    printf '{"format":{"duration":"N/A"}}'
    ;;
  slow.mp4)
    exec sleep 1 </dev/null >/dev/null 2>&1
    ;;
  large.mp4)
    index=0
    while [ "$index" -lt 8192 ]; do
      printf '0123456789abcdef'
      index=$((index + 1))
    done
    ;;
  large-stderr.mp4)
    index=0
    while [ "$index" -lt 8192 ]; do
      printf '0123456789abcdef' >&2
      index=$((index + 1))
    done
    printf '{"streams":[{"codec_type":"video","codec_name":"h264","pix_fmt":"yuv420p","width":1920,"height":1080,"duration":"1.000000"}],"format":{"duration":"1.000000"}}'
    ;;
  *)
    printf 'unexpected fixture input: %s\n' "$input" >&2
    exit 2
    ;;
esac
