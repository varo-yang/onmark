{"cases":[{"id":"product-offer","filmHtml":"<om-film><om-fields><om-field name=\"headline\" type=\"text\" default=\"Summer edit\"></om-field><om-field name=\"accent\" type=\"color\" default=\"#ff4d36\"></om-field><om-field name=\"progress\" type=\"integer\" default=\"72\"></om-field><om-field name=\"featured\" type=\"boolean\" default=\"false\"></om-field></om-fields><style>om-shot { --accent: {{accent}}; --progress: {{progress}}; } om-title { color: var(--accent); } .progress-bar { width: calc(var(--progress) * 1%); } .featured-badge { background: var(--accent); }</style><om-scene><om-shot><video src=\"media/product.mp4\"></video><om-title>{{headline}}</om-title><div class=\"progress\"><div class=\"progress-bar\"></div></div>{{#if featured}}<span class=\"featured-badge\">Featured</span>{{/if}}</om-shot></om-scene></om-film>","variantJson":"{\"headline\":\"Night edition\",\"accent\":\"#72f1b8\",\"progress\":88,\"featured\":true}"},{"id":"regional-copy","filmHtml":"<om-film><om-fields><om-field name=\"greeting\" type=\"text\" default=\"Hello\"></om-field><om-field name=\"offer\" type=\"text\" default=\"Save 20%\"></om-field></om-fields><style>om-title { display: block; }</style><om-scene><om-shot><video src=\"media/hello.mp4\"></video><om-title>{{greeting}}</om-title></om-shot><om-shot><video src=\"media/offer.mp4\"></video><om-title>{{offer}}</om-title></om-shot></om-scene></om-film>","variantJson":"{\"offer\":\"Save 30%\"}"},{"id":"boolean-badge","filmHtml":"<om-film><om-fields><om-field name=\"status\" type=\"text\" default=\"Ready\"></om-field><om-field name=\"showStatus\" type=\"boolean\" default=\"true\"></om-field></om-fields><style>.status-pill { display: inline-block; padding: 0.25rem 0.5rem; border-radius: 999px; }</style><om-scene><om-shot><video src=\"media/status.mp4\"></video>{{#if showStatus}}<span class=\"status-pill\">{{status}}</span>{{/if}}</om-shot></om-scene></om-film>","variantJson":"{\"status\":\"Rendering\",\"showStatus\":false}"},{"id":"renam